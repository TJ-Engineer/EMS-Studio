{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "OEP_BUILD_APPS": "ON",
        "OEP_BUILD_WORKERS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Developer debug build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Optimized release build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "occt-local",
      "displayName": "Developer build with local OCCT SDK",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OEP_ENABLE_OCCT_ADAPTER": "ON",
        "OEP_ENABLE_STRICT_WARNINGS": "ON",
        "OEP_OCCT_ROOT": "${sourceDir}/build/occt-sdk/usr"
      }
    },
    {
      "name": "qt-shell",
      "displayName": "Native Qt shell (Qt 6.4.2)",
      "inherits": "base",
      "environment": {
        "LD_LIBRARY_PATH": "${sourceDir}/build/qt-sdk/usr/lib/x86_64-linux-gnu:${sourceDir}/build/qt-sdk/usr/lib/x86_64-linux-gnu/libproxy:$penv{LD_LIBRARY_PATH}",
        "QML2_IMPORT_PATH": "${sourceDir}/build/qt-sdk/usr/lib/x86_64-linux-gnu/qt6/qml",
        "QT_PLUGIN_PATH": "${sourceDir}/build/qt-sdk/usr/lib/x86_64-linux-gnu/qt6/plugins"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OEP_ENABLE_QT_SHELL": "ON",
        "OEP_ENABLE_STRICT_WARNINGS": "ON",
        "OEP_QT_ROOT": "${sourceDir}/build/qt-sdk/usr",
        "OEP_QT_VERSION": "6.4.2"
      }
    },
    {
      "name": "qt-cad",
      "inherits": "qt-shell",
      "cacheVariables": {
        "OEP_ENABLE_OCCT_ADAPTER": "ON",
        "OEP_OCCT_ROOT": "${sourceDir}/build/occt-sdk/usr"
      },
      "environment": {
        "LD_LIBRARY_PATH": "${sourceDir}/build/occt-sdk/usr/lib/x86_64-linux-gnu:${sourceDir}/build/qt-sdk/usr/lib/x86_64-linux-gnu:${sourceDir}/build/qt-sdk/usr/lib/x86_64-linux-gnu/libproxy:$penv{LD_LIBRARY_PATH}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "occt-local",
      "configurePreset": "occt-local"
    },
    {
      "name": "qt-shell",
      "configurePreset": "qt-shell",
      "targets": [
        "all",
        "oep_qml_lint"
      ]
    },
    {
      "name": "qt-cad",
      "configurePreset": "qt-cad",
      "targets": [
        "all",
        "oep_qml_lint"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "occt-local",
      "configurePreset": "occt-local",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "qt-shell",
      "configurePreset": "qt-shell",
      "environment": {
        "LD_LIBRARY_PATH": "${sourceDir}/build/qt-sdk/usr/lib/x86_64-linux-gnu:${sourceDir}/build/qt-sdk/usr/lib/x86_64-linux-gnu/libproxy:$penv{LD_LIBRARY_PATH}",
        "QML2_IMPORT_PATH": "${sourceDir}/build/qt-sdk/usr/lib/x86_64-linux-gnu/qt6/qml",
        "QT_PLUGIN_PATH": "${sourceDir}/build/qt-sdk/usr/lib/x86_64-linux-gnu/qt6/plugins",
        "QT_QPA_PLATFORM": "offscreen",
        "QSG_RHI_BACKEND": "software"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "qt-cad",
      "configurePreset": "qt-cad",
      "environment": {
        "LD_LIBRARY_PATH": "${sourceDir}/build/occt-sdk/usr/lib/x86_64-linux-gnu:${sourceDir}/build/qt-sdk/usr/lib/x86_64-linux-gnu:${sourceDir}/build/qt-sdk/usr/lib/x86_64-linux-gnu/libproxy:$penv{LD_LIBRARY_PATH}",
        "QML2_IMPORT_PATH": "${sourceDir}/build/qt-sdk/usr/lib/x86_64-linux-gnu/qt6/qml",
        "QT_PLUGIN_PATH": "${sourceDir}/build/qt-sdk/usr/lib/x86_64-linux-gnu/qt6/plugins",
        "QT_QPA_PLATFORM": "offscreen",
        "QSG_RHI_BACKEND": "software"
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
